# Go
/crm-bisync
/bin/
/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.txt
coverage.html
vendor/

# Runtime state (the file-backed store writes here)
/state/
*.wal
*.snapshot

# Secrets
.env
.env.*
!.env.example
# Anchored to the repository root on purpose. An unanchored "config.json"
# also swallowed examples/config.json, which is committed and is what the
# README's output is generated from; the tests that read it passed locally
# and failed in CI, which is the whole failure mode of an over-broad ignore.
/config.json
!config.example.json

# Editors / OS
.idea/
.vscode/
.DS_Store
*.log
.worktrees/
